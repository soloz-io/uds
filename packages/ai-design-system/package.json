{
  "name": "ai-design-system",
  "version": "0.1.38",
  "private": false,
  "type": "module",
  "description": "AI-powered design system with React components, built with Tailwind CSS and Radix UI - test",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "components",
    "lib",
    "hooks",
    "utils",
    "tokens",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bizmatters/ai-design-system.git"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "tailwind",
    "radix-ui",
    "ai",
    "typescript"
  ],
  "author": "Bizmatters",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm tokens:build && next dev",
    "build": "pnpm tokens:build && pnpm prebuild && next build",
    "build:lib": "pnpm tokens:build && tsup && node scripts/build-css.js && node scripts/generate-dts.js",
    "prebuild": "node scripts/run-all-validations.js",
    "prepublishOnly": "pnpm build:lib",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs --fix",
    "tokens:build": "node build-tokens.js",
    "tokens:watch": "style-dictionary build --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "pnpm tokens:build && storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "design-schema": "^0.1.4",
    "ui-schema-contracts": "^0.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rolldown/binding-win32-x64-msvc": "1.0.0-rc.18",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.10.7",
    "@tiptap/extension-highlight": "^3.10.7",
    "@tiptap/markdown": "^3.10.7",
    "@tiptap/react": "^3.10.7",
    "@tiptap/starter-kit": "^3.10.7",
    "@xyflow/react": "12.10.0",
    "@tabler/icons-react": "^3.39.0",
    "ai": "^5.0.87",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "nanoid": "^5.1.6",
    "postcss": "^8.5.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.4.1",
    "sonner": "^2.0.7",
    "shiki": "^3.14.0",
    "streamdown": "^1.4.0",
    "tailwind-merge": "^3.3.1",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "next": "16.0.1",
    "@chromatic-com/storybook": "^4.1.2",
    "@storybook/addon-a11y": "^10.0.4",
    "@storybook/addon-docs": "^10.0.4",
    "@storybook/addon-onboarding": "^10.0.4",
    "@storybook/addon-vitest": "^10.0.4",
    "@storybook/nextjs-vite": "^10.0.4",
    "@storybook/test": "^8.6.14",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/hast": "^3.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.0.7",
    "@vitest/coverage-v8": "^4.0.7",
    "@webcontainer/env": "^1.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "eslint-plugin-storybook": "^10.0.4",
    "glob": "^13.0.6",
    "hast": "^1.0.0",
    "husky": "^9.1.7",
    "ignore-loader": "^0.1.2",
    "lint-staged": "^17.0.4",
    "playwright": "^1.56.1",
    "storybook": "^10.0.4",
    "style-dictionary": "^5.1.1",
    "tailwindcss": "^4.1.16",
    "tsup": "^8.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.7"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "lint-staged": {
    "components/**/*.{ts,tsx}": [
      "eslint --fix",
      "node scripts/validate-changed-files.js"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "node scripts/generate-dts.js"
    ]
  }
}
